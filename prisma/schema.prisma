datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  FAMILY
  STAFF
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  WITHDRAWN
}

enum RelationType {
  FAMILY
  STAFF
}

model User {
  id         Int      @id @default(autoincrement())
  identifier String   @unique
  secret     String
  name       String
  role       Role
  status     Status   @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PatientRelation {
  id                Int          @id @default(autoincrement())
  patientIdentifier String
  linkedIdentifier  String
  relationType      RelationType
  status            Status       @default(PENDING)
  createdAt         DateTime     @default(now())

  @@unique([patientIdentifier, linkedIdentifier])
  @@map("staff_person_assignments") // ✨ 실제 DB 테이블명을 staff_person_assignments로 매핑
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   String   
  action    String   
  target    String   
  details   String?  
  createdAt DateTime @default(now())
}